# PostgreSQL connection string used by the app at runtime.
# Supabase (region af-south-1 for POPIA): use the TRANSACTION POOLER URL
# (port 6543) and append ?pgbouncer=true&connection_limit=1
# e.g. postgresql://postgres.<ref>:<pw>@aws-0-af-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:password@localhost:5432/heya_performance"

# Direct (non-pooled) connection, used only by `prisma migrate`.
# Supabase: the same credentials on port 5432 (Session mode / direct).
# Local dev: same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/heya_performance"

# Auth.js. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# The canonical URL of the deployed app, e.g. https://performance.heya.team
# Required behind Azure App Service's proxy so callback URLs are correct.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Microsoft Entra ID app registration (single tenant).
# Redirect URI to register: {AUTH_URL}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Use the Heya Directory (tenant) ID — never "common": single-tenant only.
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<heya-tenant-id>/v2.0"

# Shared secret for scheduled jobs (POST /api/jobs/close-week hourly-safe,
# POST /api/jobs/notifications hourly at minute 0).
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Microsoft Graph mail (app registration with APPLICATION permission
# Mail.Send, admin-consented, ideally scoped to the sender mailbox with an
# application access policy). Leave empty to skip sending (logged instead).
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_SENDER="performance@heya.team"
