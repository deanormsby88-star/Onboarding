# ─── Database (required) ─────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase: Settings → Database → Connection string).
# The schema is created automatically on first use (or run: npm run migrate).
DATABASE_URL=postgres://user:password@localhost:5432/floorwalk

# ─── Email (required for the report mail) ────────────────────────────────────
# SMTP credentials. For Microsoft 365 / Outlook:
#   SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=false,
#   SMTP_USER=<mailbox>, SMTP_PASS=<app password>.
# If unset, walks still save to the DB and the PDF stays downloadable in-app —
# only the email is skipped (the submit screen tells you).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Comma-separated recipients of the floor-walk report (Dean + Jesse in HR).
REPORT_RECIPIENTS=deano@heya.team,jesse@heya.team

# Timezone used for dates in the PDF and email (default Africa/Johannesburg).
REPORT_TIMEZONE=Africa/Johannesburg
